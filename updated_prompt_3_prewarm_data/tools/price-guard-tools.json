{
  "openapi": "3.0.0",
  "info": {
    "title": "PriceOS Price Guard Tools",
    "version": "1.0.0",
    "description": "Tools used by the Price Guard agent (Step 4/5). Reads the three upstream cached outputs (Property Analyst, Booking Intelligence, Market Research) and synthesises per-date pricing proposals constrained by floor/ceiling guardrails."
  },
  "servers": [
    {
      "url": "https://sadistically-calycine-carry.ngrok-free.dev/api/agent-tools/v1",
      "description": "Local dev server tunnelled via ngrok"
    }
  ],
  "paths": {
    "/get-property-analysis": {
      "get": {
        "summary": "Property Analyst's cached output",
        "description": "Returns the cached strict JSON output from the Property Analyst agent. Use this for floor/ceiling/base price + daily calendar.",
        "operationId": "get_property_analysis",
        "parameters": [
          {
            "name": "orgId",
            "in": "query",
            "description": "MongoDB ObjectId of the organisation",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "listingId",
            "in": "query",
            "description": "MongoDB ObjectId of the listing",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "description": "Window start (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "description": "Window end (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached Property Analyst JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "data"],
                  "properties": {
                    "status": { "type": "string", "enum": ["success"] },
                    "data": { "type": "object", "description": "Property Analyst strict JSON" }
                  }
                }
              }
            }
          },
          "404": { "description": "No cached Property Analyst output" }
        }
      }
    },
    "/get-booking-intelligence": {
      "get": {
        "summary": "Booking Intelligence's cached output",
        "description": "Returns the cached strict JSON output from the Booking Intelligence agent. Use this for pacing %, channel mix, cancellation rate.",
        "operationId": "get_booking_intelligence",
        "parameters": [
          {
            "name": "orgId",
            "in": "query",
            "description": "MongoDB ObjectId of the organisation",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "listingId",
            "in": "query",
            "description": "MongoDB ObjectId of the listing",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "description": "Window start (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "description": "Window end (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached Booking Intelligence JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "data"],
                  "properties": {
                    "status": { "type": "string", "enum": ["success"] },
                    "data": { "type": "object", "description": "Booking Intelligence strict JSON" }
                  }
                }
              }
            }
          },
          "404": { "description": "No cached Booking Intelligence output" }
        }
      }
    },
    "/get-market-research": {
      "get": {
        "summary": "Market Research's cached output",
        "description": "Returns the cached strict JSON output from the Market Research agent. Use this for confirmed events, news digest, competitor P25/P50/P75/P90, and verdict.",
        "operationId": "get_market_research",
        "parameters": [
          {
            "name": "orgId",
            "in": "query",
            "description": "MongoDB ObjectId of the organisation",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "listingId",
            "in": "query",
            "description": "MongoDB ObjectId of the listing",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "description": "Window start (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "description": "Window end (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached Market Research JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "data"],
                  "properties": {
                    "status": { "type": "string", "enum": ["success"] },
                    "data": { "type": "object", "description": "Market Research strict JSON" }
                  }
                }
              }
            }
          },
          "404": { "description": "No cached Market Research output" }
        }
      }
    }
  }
}
