{
  "openapi": "3.0.0",
  "info": {
    "title": "PriceOS Aria Concierge Tools",
    "version": "1.0.0",
    "description": "Tools for Aria Concierge (Lyzr agent 6a09d9428e3a6bafa13d8284). Every tool is a sub-second MongoDB lookup against the AgentCache collection. There are no LLM calls or external APIs behind these tools — they serve pre-computed analyst outputs cached by the precompute orchestrator. All responses use the envelope { status, data, metadata }. Always call get_cache_status first to know which reports are warm."
  },
  "servers": [
    {
      "url": "https://sadistically-calycine-carry.ngrok-free.dev/api/agent-tools/v1",
      "description": "Local dev server tunnelled via ngrok"
    }
  ],
  "paths": {
    "/get-cache-status": {
      "get": {
        "summary": "Cache freshness across all 5 analyses",
        "description": "Returns per-agent availability and age (in minutes) for the cached analyses for this listing + date window. ALWAYS call this first. If cache_state is 'cold' or any required report is missing, instruct the user to click Refresh Intelligence — do NOT call other tools.",
        "operationId": "get_cache_status",
        "parameters": [
          {
            "name": "orgId",
            "in": "query",
            "description": "MongoDB ObjectId of the organization",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "listingId",
            "in": "query",
            "description": "MongoDB ObjectId of the listing",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "description": "Start of analysis window (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "description": "End of analysis window (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Per-agent cache freshness map",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "data", "metadata"],
                  "properties": {
                    "status": { "type": "string", "enum": ["success"] },
                    "data": {
                      "type": "object",
                      "required": ["cache_state", "listing_id", "date_from", "date_to", "fresh_count", "agents"],
                      "properties": {
                        "cache_state": {
                          "type": "string",
                          "enum": ["warm", "partial", "cold"],
                          "description": "warm = all 5 reports fresh; partial = some missing or stale; cold = nothing cached"
                        },
                        "listing_id": { "type": "string" },
                        "date_from": { "type": "string", "format": "date" },
                        "date_to": { "type": "string", "format": "date" },
                        "fresh_count": { "type": "integer", "minimum": 0, "maximum": 5 },
                        "agents": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["agent", "available", "status", "ageMinutes"],
                            "properties": {
                              "agent": {
                                "type": "string",
                                "enum": ["property", "booking", "market_research", "price_guard", "anomaly"]
                              },
                              "available": { "type": "boolean" },
                              "status": {
                                "type": "string",
                                "enum": ["fresh", "stale", "failed", "missing"]
                              },
                              "ageMinutes": { "type": "integer", "nullable": true }
                            }
                          }
                        }
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "requestId": { "type": "string" },
                        "timestamp": { "type": "string", "format": "date-time" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Bad request" }
        }
      }
    },
    "/get-property-analysis": {
      "get": {
        "summary": "Cached PropertyAnalyst output",
        "description": "Returns the cached PropertyAnalyst report: property profile (name, area, bedrooms, base/floor/ceiling), calendar summary (occupancy %, booked/blocked/available days), full daily inventory, active reservations, active pricing rules, and revenue for the window.",
        "operationId": "get_property_analysis",
        "parameters": [
          {
            "name": "orgId",
            "in": "query",
            "description": "MongoDB ObjectId of the organization",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "listingId",
            "in": "query",
            "description": "MongoDB ObjectId of the listing",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "description": "Start of analysis window (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "description": "End of analysis window (YYYY-MM-DD)",
            "required": true,
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
          }
        ],
        "responses": {
          "200": {
            "description": "Cached PropertyAnalyst JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "data", "metadata"],
                  "properties": {
                    "status": { "type": "string", "enum": ["success"] },
                    "data": {
                      "type": "object",
                      "description": "PropertyAnalyst report — see updated_prompts_2/02-property-analyst.md Precompute Mode schema",
                      "properties": {
                        "property_profile": { "type": "object" },
                        "calendar_summary": { "type": "object" },
                        "daily_calendar": { "type": "array", "items": { "type": "object" } },
                        "active_reservations": { "type": "array", "items": { "type": "object" } },
                        "pricing_rules_active": { "type": "array", "items": { "type": "object" } },
                        "revenue_window": { "type": "object" }
                      }
                    },
                    "metadata": {
                      "type": "object",
                      "properties": {
                        "requestId": { "type": "string" },
                        "timestamp": { "type": "string", "format": "date-time" },
                        "computed_at": { "type": "string", "format": "date-time" },
                        "age_minutes": { "type": "integer" },
                        "cache_state": { "type": "string", "enum": ["fresh", "stale"] }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Cache miss — user must click Refresh Intelligence" }
        }
      }
    },
