{
  "openapi": "3.0.3",
  "info": {
    "title": "PriceOS Property Analyst Agent Tools",
    "version": "1.0.0",
    "description": "Tools for the Property Analyst sub-agent. Fetches property profile and calendar occupancy metrics. All responses use the standard envelope: { status, data, metadata }."
  },
  "servers": [
    { "url": "https://sadistically-calycine-carry.ngrok-free.dev/api/agent-tools/v1" }
  ],
  "paths": {
    "/get-property-profile": {
      "get": {
        "operationId": "get_property_profile",
        "summary": "Property profile and pricing bounds",
        "description": "Fetches static property details: name, area, city, bedroom/bathroom count, base price, price floor, price ceiling, and amenities. Use this to establish guardrail bounds [priceFloor, priceCeiling] before any pricing computation.",
        "parameters": [
          {
            "name": "orgId",
            "in": "query",
            "required": true,
            "description": "MongoDB ObjectId of the organization",
            "schema": { "type": "string" }
          },
          {
            "name": "listingId",
            "in": "query",
            "required": true,
            "description": "MongoDB ObjectId of the listing",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Property profile with pricing bounds",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PropertyProfileResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/get-property-calendar-metrics": {
      "get": {
        "operationId": "get_property_calendar_metrics",
        "summary": "Calendar occupancy and revenue metrics",
        "description": "Fetches day-by-day calendar data for a date range: each day's status (booked/available/blocked), nightly price, and min_stay. Also returns computed aggregate metrics: occupancy%, total revenue, booked/available/blocked day counts, and average nightly rate.",
        "parameters": [
          {
            "name": "orgId",
            "in": "query",
            "required": true,
            "description": "MongoDB ObjectId of the organization",
            "schema": { "type": "string" }
          },
          {
            "name": "listingId",
            "in": "query",
            "required": true,
            "description": "MongoDB ObjectId of the listing",
            "schema": { "type": "string" }
          },
          {
            "name": "dateFrom",
            "in": "query",
            "required": true,
            "description": "Start of the analysis window (YYYY-MM-DD)",
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "example": "2026-06-01" }
          },
          {
            "name": "dateTo",
            "in": "query",
            "required": true,
            "description": "End of the analysis window (YYYY-MM-DD)",
            "schema": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "example": "2026-06-30" }
          }
        ],
        "responses": {
          "200": {
            "description": "Calendar days and aggregate occupancy metrics",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CalendarMetricsResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiMetadata": {
        "type": "object",
        "properties": {
          "requestId": { "type": "string", "example": "req_a1b2c3d4e5f6" },
          "timestamp": { "type": "string", "format": "date-time", "example": "2026-06-01T08:00:00.000Z" }
        }
      },
      "PropertyProfileResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "data": { "$ref": "#/components/schemas/PropertyProfileData" },
          "metadata": { "$ref": "#/components/schemas/ApiMetadata" }
        }
      },
      "PropertyProfileData": {
        "type": "object",
        "description": "Static property details and pricing guardrails",
        "properties": {
          "listingId": { "type": "string", "description": "MongoDB ObjectId (internal)", "example": "69d776a671c7b939aaf49053" },
          "name": { "type": "string", "example": "Marina Heights 1BR" },
          "area": { "type": "string", "example": "Dubai Marina" },
          "city": { "type": "string", "example": "Dubai" },
          "bedrooms": { "type": "integer", "example": 1 },
          "bathrooms": { "type": "number", "format": "double", "example": 1.5 },
          "personCapacity": { "type": "integer", "example": 4 },
          "basePrice": { "type": "number", "format": "double", "description": "Default nightly rate in AED", "example": 620 },
          "priceFloor": { "type": "number", "format": "double", "description": "Absolute minimum price — never go below this", "example": 430 },
          "priceCeiling": { "type": "number", "format": "double", "description": "Absolute maximum price — never exceed this", "example": 1400 },
          "currencyCode": { "type": "string", "example": "AED" },
          "amenities": {
            "type": "array",
            "items": { "type": "string" },
            "example": ["Pool", "Gym", "Parking", "WiFi", "Air Conditioning"]
          }
        }
      },
      "CalendarMetricsResponse": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["success"] },
          "data": { "$ref": "#/components/schemas/CalendarMetricsData" },
          "metadata": { "$ref": "#/components/schemas/ApiMetadata" }
        }
      },
      "CalendarMetricsData": {
        "type": "object",
        "properties": {
          "metrics": { "$ref": "#/components/schemas/OccupancyMetrics" },
          "days": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CalendarDay" }
          }
        }
      },
      "OccupancyMetrics": {
        "type": "object",
        "properties": {
          "totalDays": { "type": "integer", "example": 30 },
          "bookedDays": { "type": "integer", "example": 18 },
          "blockedDays": { "type": "integer", "example": 2 },
          "bookableDays": { "type": "integer", "example": 28 },
          "occupancyPct": { "type": "number", "format": "double", "example": 64.3 },
          "avgNightlyRate": { "type": "number", "format": "double", "description": "Average price across all calendar days in AED", "example": 620 },
          "totalRevenue": { "type": "number", "format": "double", "description": "Sum of price × nights for all booked days in AED", "example": 11160 }
        }
      },
      "CalendarDay": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date", "example": "2026-06-01" },
          "status": { "type": "string", "enum": ["booked", "available", "blocked"] },
          "price": { "type": "number", "format": "double", "description": "Current nightly rate in AED", "example": 620 },
          "minStay": { "type": "integer", "example": 2 },
          "maxStay": { "type": "integer", "example": 30 },
          "reservationId": { "type": "string", "nullable": true, "example": null }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid or missing query parameters",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "enum": ["error"] },
                "error": { "type": "object", "properties": { "code": { "type": "string", "example": "VALIDATION_ERROR" }, "message": { "type": "string", "example": "dateFrom is required" } } }
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Listing or organization not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "enum": ["error"] },
                "error": { "type": "object", "properties": { "code": { "type": "string", "example": "NOT_FOUND" }, "message": { "type": "string", "example": "Listing not found" } } }
              }
            }
          }
        }
      }
    }
  }
}
