{
  "openapi": "3.0.0",
  "info": {
    "title": "aria-cache-tools",
    "version": "1.0.0",
    "description": "Aria (CRO Router) cache-reader tools + audit. Aria reads the precomputed worker analyses from AgentCache and logs decisions. All GET. Verified live: all return HTTP 200."
  },
  "servers": [
    { "url": "https://sadistically-calycine-carry.ngrok-free.dev/api/agent-tools/v1" }
  ],
  "paths": {
    "/get-cache-status": {
      "get": {
        "operationId": "get_cache_status",
        "summary": "Which precomputed analyses are fresh/stale/missing for this listing+window.",
        "parameters": [
          { "name": "orgId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "listingId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "dateFrom", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "dateTo", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "Per-agent cache freshness." } }
      }
    },
    "/get-property-analysis": {
      "get": {
        "operationId": "get_property_analysis",
        "summary": "Cached PropertyAnalyst output (occupancy, gap nights, revenue forecast). AUTHORITATIVE.",
        "parameters": [
          { "name": "orgId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "listingId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "dateFrom", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "dateTo", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "Cached PropertyAnalyst JSON." }, "404": { "description": "Cache miss." } }
      }
    },
    "/get-booking-intelligence": {
      "get": {
        "operationId": "get_booking_intelligence",
        "summary": "Cached BookingIntelligence output (velocity, LOS, channels, ADR vs benchmark).",
        "parameters": [
          { "name": "orgId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "listingId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "dateFrom", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "dateTo", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "Cached BookingIntelligence JSON." }, "404": { "description": "Cache miss." } }
      }
    },
    "/get-market-research": {
      "get": {
        "operationId": "get_market_research",
        "summary": "Cached MarketResearch output (regime, comp-set, events, source markets, sentiment).",
        "parameters": [
          { "name": "orgId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "listingId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "dateFrom", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "dateTo", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "Cached MarketResearch JSON." }, "404": { "description": "Cache miss." } }
      }
    },
    "/get-price-guard-report": {
      "get": {
        "operationId": "get_price_guard_report",
        "summary": "Cached PriceGuard pricing decision (chosen price, verdict, guardrails).",
        "parameters": [
          { "name": "orgId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "listingId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "dateFrom", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "dateTo", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "Cached PriceGuard JSON." }, "404": { "description": "Cache miss." } }
      }
    },
    "/get-anomaly-report": {
      "get": {
        "operationId": "get_anomaly_report",
        "summary": "Cached AnomalyDetector report (anomaly score, severity, rollback flag).",
        "parameters": [
          { "name": "orgId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "listingId", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "dateFrom", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } },
          { "name": "dateTo", "in": "query", "required": true, "schema": { "type": "string", "format": "date" } }
        ],
        "responses": { "200": { "description": "Cached AnomalyDetector JSON." }, "404": { "description": "Cache miss." } }
      }
    },
    "/audit_log_decision": {
      "get": {
        "operationId": "audit_log_decision",
        "summary": "Persist an agent decision; returns an audit_decision_id.",
        "parameters": [
          { "name": "agent_name", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "{status, audit_decision_id}" } }
      }
    }
  }
}
